/* pages/goal/goal.wxss */

/* ============ 汇总卡 ============ */
.hero {
  position: relative;
  margin: 24rpx 28rpx 0;
  padding: 36rpx 36rpx 34rpx;
  border-radius: 36rpx;
  overflow: hidden;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F5CE8E 0%, #E9A23B 54%, #D98F2C 100%);
  box-shadow: 0 16rpx 36rpx rgba(230, 143, 38, 0.26);
}
.hero-mask {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  top: -130rpx;
  right: -80rpx;
}
.hero-label {
  position: relative;
  z-index: 1;
  font-size: 27rpx;
  opacity: 0.94;
}
.hero-num {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 12rpx;
}
.hero-cur {
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 8rpx;
}
.hero-num .num {
  font-size: 86rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
}
.hero-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  opacity: 0.94;
  margin-bottom: 26rpx;
}
.hero-bar {
  position: relative;
  z-index: 1;
}
.hero .bar {
  background: rgba(255, 255, 255, 0.28);
}
.hero .bar-fill {
  border-radius: 8rpx;
}

/* ============ 目标卡 ============ */
.gcard {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(214, 158, 168, 0.10);
}
.gc-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}
.gc-head:active {
  opacity: 0.72;
}
.gc-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.gc-title {
  flex: 1;
  min-width: 0;
}
.gc-name {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  color: #3A3336;
}
.gc-sub {
  display: block;
  font-size: 23rpx;
  color: #A79DA2;
  margin-top: 6rpx;
}
.gc-pct {
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.gc-foot {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}
.gc-saved {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3336;
}
.gc-target {
  font-size: 24rpx;
  color: #A79DA2;
  margin-left: 8rpx;
}
.gc-btn {
  margin-left: auto;
  padding: 12rpx 30rpx;
  border-radius: 28rpx;
  background: #FEF4E4;
  color: #C9821A;
  font-size: 25rpx;
  font-weight: 600;
}
.gc-btn:active {
  background: #FBE4C4;
  transform: scale(0.96);
}

.gc-tip {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #FAF5EF;
  font-size: 23rpx;
  color: #8B7C6B;
  line-height: 1.5;
}

.new-btn {
  margin-top: 32rpx;
}

.foot-note {
  font-size: 22rpx;
  color: #B9AFB4;
  line-height: 1.65;
  padding: 26rpx 12rpx 40rpx;
  text-align: center;
}

/* ============ 弹层 ============ */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(46, 42, 43, 0.38);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.26s cubic-bezier(0.2, 0.9, 0.3, 1) both;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 22rpx;
  border-bottom: 2rpx solid #F0E9E5;
  flex-shrink: 0;
}
.sh-cancel {
  font-size: 28rpx;
  color: #A79DA2;
}
.sh-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A3336;
}
.sh-ok {
  font-size: 28rpx;
  font-weight: 700;
  color: #D65C80;
}

.sheet-body {
  padding: 12rpx 32rpx 20rpx;
  overflow-y: auto;
  flex: 1;
}
.sheet-safe {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

/* ============ 表单 ============ */
.fl {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  border-bottom: 2rpx solid #F0E9E5;
}
.fl-k {
  width: 210rpx;
  font-size: 27rpx;
  color: #6E6569;
  flex-shrink: 0;
}
.fl-in {
  flex: 1;
  font-size: 30rpx;
  color: #3A3336;
  text-align: right;
  min-width: 0;
}
.fl-unit {
  font-size: 24rpx;
  color: #A79DA2;
  margin-left: 10rpx;
  flex-shrink: 0;
}
.fl-picker {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #3A3336;
}
.fl-clear {
  font-size: 23rpx;
  color: #C4BABF;
  margin-left: 16rpx;
}
.ph {
  color: #CFC5C9;
}

.emoji-row {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.em {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin: 6rpx 0 6rpx 12rpx;
  background: #F5F0EC;
}
.em.on {
  background: #FEF5F8;
  border: 3rpx solid #F2A0B5;
}

.sheet-del {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: 27rpx;
  color: #D95A54;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FDEDEC;
}

/* ============ 存一笔 ============ */
.dp-seg {
  display: inline-flex;
  background: #F1EAE6;
  border-radius: 30rpx;
  padding: 6rpx;
  margin: 20rpx 0 8rpx;
}
.dp-seg-i {
  padding: 12rpx 38rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  color: #6E6569;
}
.dp-seg-i.on {
  background: #FFFFFF;
  color: #D65C80;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(180, 140, 148, 0.16);
}

.dp-amt {
  display: flex;
  align-items: baseline;
  padding: 28rpx 0 20rpx;
  border-bottom: 4rpx solid #F7DCE5;
}
.dp-cur {
  font-size: 44rpx;
  font-weight: 700;
  color: #D65C80;
  margin-right: 12rpx;
}
.dp-in {
  flex: 1;
  font-size: 72rpx;
  font-weight: 700;
  color: #3A3336;
  min-width: 0;
}

.dp-quick {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.dq {
  padding: 14rpx 34rpx;
  border-radius: 26rpx;
  background: #FEF5F8;
  color: #D65C80;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.dq:active {
  background: #F7DCE5;
  transform: scale(0.95);
}

.dp-tip {
  font-size: 23rpx;
  color: #A79DA2;
  margin-top: 18rpx;
  padding-bottom: 30rpx;
}
