/* pages/me/me.wxss */

/* ============ 概览卡 ============ */
.head-card {
  position: relative;
  margin: 24rpx 28rpx 8rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 36rpx;
  overflow: hidden;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F2A0B5 0%, #EE7396 52%, #DE5E82 100%);
  box-shadow: 0 16rpx 36rpx rgba(239, 84, 120, 0.26);
}
.hc-mask {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.11);
  top: -150rpx;
  right: -100rpx;
}
.hc-t {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hc-s {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}
.hc-grid {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
}
.hc-i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hc-v {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}
.hc-k {
  font-size: 21rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}
.hc-line {
  width: 2rpx;
  height: 46rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* ============ 分组列表 ============ */
.group {
  background: #FFFFFF;
  border-radius: 28rpx;
  margin-top: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(214, 158, 168, 0.09);
}

.cell {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 2rpx solid #F5F0EC;
}
.cell:last-child {
  border-bottom: none;
}
.cell.no-tap {
  border-bottom: none;
  padding-bottom: 14rpx;
}
.cell-on {
  background: #FEF5F8;
}

/* ---------- 主题色选择（95 后最吃这一口：可自定义） ---------- */
.theme-row {
  display: flex;
  padding: 4rpx 22rpx 26rpx;
  gap: 16rpx;
}
.th-item {
  flex: 1;
  height: 116rpx;
  border-radius: 22rpx;
  background: #F7F2EF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform .18s cubic-bezier(.34, 1.4, .5, 1);
}
.th-on {
  transform: scale(.94);
}
.th-item.on {
  background: var(--pink-soft);
  box-shadow: inset 0 0 0 3rpx var(--pink);
}
.th-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--pink);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, .10);
  margin-bottom: 10rpx;
}
.th-name {
  font-size: 21rpx;
  color: #6E6569;
}
.th-item.on .th-name {
  color: var(--pink-deep);
  font-weight: 600;
}
.th-check {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: var(--pink-deep);
  font-weight: 700;
}
.c-ico {
  width: 56rpx;
  font-size: 34rpx;
  flex-shrink: 0;
}
.c-t {
  font-size: 29rpx;
  color: #3A3336;
  font-weight: 500;
}
.c-sub {
  font-size: 22rpx;
  color: #B9AFB4;
  margin-left: 16rpx;
}
.c-v {
  margin-left: auto;
  font-size: 26rpx;
  color: #A79DA2;
}
.c-go {
  font-size: 34rpx;
  color: #CFC5C9;
  margin-left: 14rpx;
  flex-shrink: 0;
}
.cell.danger .c-t {
  color: #D95A54;
}

/* ============ 使用说明 ============ */
.how {
  padding: 8rpx 30rpx 28rpx;
  background: #F5F0EC;
}
.how-line {
  font-size: 24rpx;
  color: #6E6569;
  line-height: 1.75;
  margin-top: 14rpx;
}

/* ============ 关于 ============ */
.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 50rpx;
}
.about-t {
  font-size: 24rpx;
  color: #B9AFB4;
}
.about-s {
  font-size: 21rpx;
  color: #C4BABF;
  margin-top: 10rpx;
}
