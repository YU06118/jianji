/* pages/budget/budget.wxss */

.card-title {
  display: block;
}
.sub {
  font-size: 24rpx;
  color: #A79DA2;
  margin-top: 8rpx;
  line-height: 1.55;
}

/* ============ 总预算输入 ============ */
.total-input {
  display: flex;
  align-items: baseline;
  margin-top: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid #F7DCE5;
}
.ti-cur {
  font-size: 42rpx;
  font-weight: 700;
  color: #EE7396;
  margin-right: 12rpx;
}
.ti-in {
  flex: 1;
  font-size: 68rpx;
  font-weight: 700;
  color: #3A3336;
  letter-spacing: -1rpx;
  min-width: 0;
}
.ti-unit {
  font-size: 24rpx;
  color: #A79DA2;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.ph {
  color: #CFC5C9;
  font-weight: 400;
}

.sug-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}
.sug-pill {
  font-size: 23rpx;
  color: #D65C80;
  background: #FEF5F8;
  border-radius: 22rpx;
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
}
.sug-pill:active {
  background: #F7DCE5;
}

/* ============ 分项预算 ============ */
.cb-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0E9E5;
}
.cb-item:last-of-type {
  border-bottom: none;
}
.cb-ico {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cb-name {
  font-size: 28rpx;
  color: #3A3336;
  font-weight: 500;
  flex-shrink: 0;
}
.cb-right {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.cb-cur {
  font-size: 25rpx;
  color: #A79DA2;
  margin-right: 6rpx;
}
.cb-in {
  width: 200rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3A3336;
  text-align: right;
}

.cb-sum {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #F5F0EC;
  font-size: 26rpx;
  color: #6E6569;
}
.cb-sum.warn {
  background: #FEF4E4;
  color: #B87A18;
}
.cb-diff {
  font-size: 23rpx;
  font-weight: 600;
}

/* ============ 提示 ============ */
.tip-box {
  padding: 4rpx 40rpx 220rpx;
}
.tip-line {
  font-size: 23rpx;
  color: #A79DA2;
  line-height: 1.7;
  margin-bottom: 14rpx;
}

/* ============ 底部按钮 ============ */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 247, 245, 0.96);
  border-top: 2rpx solid #F0E9E5;
  display: flex;
  align-items: center;
}
.save-bar .btn {
  flex: 1;
}
.btn-clear {
  flex: 0 0 210rpx !important;
  margin-left: 20rpx;
}
